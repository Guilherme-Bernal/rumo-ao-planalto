diff --git a/src/ui.css b/src/ui.css
new file mode 100644
index 0000000..bc654b7
--- /dev/null
+++ b/src/ui.css
@@ -0,0 +1,80 @@
+/* ===== Polimento de UI/UX (organização das abas, hierarquia, celular) ===== */
+
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+button:focus:not(:focus-visible) { outline: none; }
+
+/* painéis */
+.panel { box-shadow: 0 8px 28px rgba(0, 0, 0, .32); backdrop-filter: blur(10px); }
+.main { max-height: calc(100vh - 150px); scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.25) transparent; }
+.bar { height: 7px; }
+.stat { transition: transform .15s; }
+
+/* cabeçalho enxuto */
+.top { padding: 9px 16px; }
+.top .who { font-size: 1.02rem; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
+.top .meta { font-size: .82rem; }
+.top .trail { margin-top: 5px; }
+.topbtns .ico-m { display: none; }
+.top button { white-space: nowrap; }
+
+/* meta + passos da rodada */
+.hub .goal { display: grid; gap: 6px; padding: 10px 12px; }
+.goal .meta-line { display: flex; justify-content: space-between; align-items: baseline; gap: 4px 12px; flex-wrap: wrap; color: var(--muted); font-size: .82rem; }
+.goal .meta-line b { color: var(--text); }
+.goal .left { color: var(--accent); font-weight: 600; white-space: nowrap; }
+.hub .todo { display: flex; gap: 8px; align-items: center; margin: 0; font-size: .92rem; }
+.pips { display: inline-flex; gap: 4px; flex: none; }
+.pips i { width: 8px; height: 8px; border-radius: 50%; background: rgba(255, 255, 255, .22); }
+.pips i.on { background: var(--accent); }
+.pips i.cur { box-shadow: 0 0 0 3px rgba(251, 191, 36, .3); }
+
+/* navegação: 4 grupos + sub-abas, fixa no topo do painel */
+.navwrap { position: sticky; top: -16px; z-index: 7; margin: 0 -16px 12px; padding: 8px 16px 8px; background: rgba(12, 18, 32, .97); border-bottom: 1px solid var(--border); }
+.tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; margin: 0; flex-wrap: nowrap; }
+.tabs button { padding: 8px 4px; font-size: .88rem; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.subtabs { display: flex; gap: 6px; margin-top: 8px; overflow-x: auto; scrollbar-width: none; }
+.subtabs::-webkit-scrollbar { display: none; }
+.subtabs button { flex: none; padding: 5px 12px; border-radius: 99px; font-size: .82rem; text-align: center; position: relative; }
+.subtabs button.on { background: rgba(251, 191, 36, .18); border-color: var(--accent); color: var(--accent); font-weight: 700; }
+
+/* botão de números no celular */
+.stats-toggle { display: none; }
+
+@media (prefers-reduced-motion: reduce) {
+  * { transition-duration: .01ms !important; animation-duration: .01ms !important; scroll-behavior: auto !important; }
+}
+
+/* ===== celular / tablet ===== */
+@media (max-width: 900px) {
+  /* o 3D vira uma faixa fixa no topo; o resto rola por cima */
+  .scene { bottom: auto; height: 36vh; height: 36svh; }
+  .hud { background: transparent; padding: 8px 8px 84px; min-height: 0; }
+  .panel { background: rgba(12, 18, 32, .93); border-radius: 14px; padding: 12px; }
+  .hud > .top { margin-bottom: calc(36vh - 66px); margin-bottom: calc(36svh - 66px); min-height: 56px; padding: 8px 12px; background: rgba(12, 18, 32, .78); }
+  .top .meta { font-size: .78rem; }
+  .top .trail span { display: none; }
+  .top .trail span.on, .top .trail span.on + span { display: inline-block; }
+  .topbtns { flex-wrap: nowrap; }
+  .topbtns .btn-lbl { display: none; }
+  .topbtns .ico-m { display: inline; }
+  .top button { padding: 6px 10px; }
+
+  .stats.compact .more { display: none; }
+  .stats .stats-toggle { display: block; grid-column: 1 / -1; text-align: center; font-size: .82rem; padding: 6px; }
+
+  .main { max-height: none; }
+  .navwrap { top: 0; margin: 0 -12px 10px; padding: 8px 12px; }
+  .tabs { grid-template-columns: .9fr 1.3fr 1.05fr 1.1fr; gap: 4px; }
+  .tabs button { font-size: .74rem; padding: 8px 0; text-overflow: clip; }
+
+  button.apoie-fab { right: 10px; bottom: 10px; width: 44px; height: 44px; padding: 0; font-size: 0; border-radius: 50%; text-align: center; }
+  button.apoie-fab::before { content: '☕'; font-size: 1.3rem; }
+  .apoie { bottom: 64px; }
+}
+
+/* alvos de toque confortáveis */
+@media (pointer: coarse) {
+  button { min-height: 44px; }
+  .subtabs button { min-height: 40px; }
+  .chip { min-height: 0; }
+}